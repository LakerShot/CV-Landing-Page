# This machine's IPv6 route to the npm registry blackholes: every request over
# AAAA times out before falling back, which made installs take ~13 min *per
# package*. Forcing IPv4 resolution first fixes it. Remove if the network is
# ever fixed; harmless either way.
node-options=--dns-result-order=ipv4first

fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=30000
fetch-timeout=180000
